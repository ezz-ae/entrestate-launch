generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  brandKit  Json?
  profileJson Json?
  googleAdsTokens Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users          User[]
  userTenants    UserTenant[]
  projects       Project[]
  leads          Lead[]
  campaigns      Campaign[]
  uploads        Upload[]
  agentTraining  AgentTraining[]
  orders         Order[]
  products       Product[]
  payments       Payment[]
  entitlements   Entitlement[]
  deployments    Deployment[]
  editRequests   EditRequest[]
  jobs           Job[]
  chatAgents     ChatAgent[]
  teamInvites    TeamInvite[]
  sites          Site[]
  chatSessions   ChatSession[]
  leadSetting    LeadSetting?
  domainRequests DomainRequest[]
  contacts       Contact[]
  inventoryItems InventoryItem[]
  projectDrafts  ProjectDraft[]
  adsBlueprints  AdsBlueprint[]
  adsCampaigns   AdsCampaign[]
  adsLearningSignals AdsLearningSignal[]
  adsRefinerRuns AdsRefinerRun[]
  wallet         Wallet?
  projectActions ProjectAction[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt    DateTime @default(now())
  tenantId      String?
  role          String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  memberships UserTenant[]
  chatAgents ChatAgent[]
  loginTokens LoginToken[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}


model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("member")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model TeamInvite {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String
  status    String
  invitedBy String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  city        String?
  community   String?
  developer   String?
  priceMin    Decimal?
  priceMax    Decimal?
  rentalYield Decimal?
  sortScore   Int?
  firstPage   Boolean?
  imagesJson  Json?
  dataJson    Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  uploads Upload[]
  agentTraining AgentTraining[]
  orders Order[]
  shareLinks ShareLink[]
  projectDrafts ProjectDraft[]
  projectActions ProjectAction[]

  @@unique([tenantId, slug])
}

model Site {
  id             String   @id @default(cuid())
  tenantId       String?
  ownerUid       String?
  title          String?
  subdomain      String?
  customDomain   String?
  published      Boolean  @default(false)
  publishedUrl   String?
  status         String?
  dataJson       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastPublishedAt DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ownerUid])
  @@index([subdomain])
  @@index([customDomain])
}

model ChatSession {
  id            String   @id @default(cuid())
  tenantId      String
  projectId     String?
  humanTakeover Boolean  @default(false)
  conversation  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
}

model Lead {
  id        String   @id @default(cuid())
  tenantId  String
  siteId    String?
  projectId String?
  orderId   String?
  deploymentId String?
  name      String?
  phone     String?
  email     String?
  emailNormalized String?
  phoneNormalized String?
  message   String?
  source    String?
  utmJson   Json?
  notes     String?
  status    String?
  priority  String?
  touches   Int      @default(0)
  lastSeenAt DateTime?
  updatedAt DateTime @updatedAt
  context   Json?
  metadata  Json?
  intentScore Float?
  intentFocus String?
  intentReasoning String?
  intentProjectIds String[] @default([])
  intentNextAction String?
  pipelineDecision String?
  pipelineDecisionAt DateTime?
  pipelineDecisionReason String?
  ignoredReason String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([tenantId, createdAt])
  @@index([emailNormalized])
  @@index([phoneNormalized])
}

model LeadSetting {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  notificationEmail String?
  crmWebhookUrl     String?
  crmProvider       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DomainRequest {
  id           String   @id @default(cuid())
  tenantId     String
  domain       String
  provider     String
  siteId       String?
  status       String
  requestedBy  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model ShareLink {
  id        String   @id @default(cuid())
  projectId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  platform    String
  name        String
  utmSource   String?
  utmCampaign String?
  spend       Decimal?
  metaJson    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum UploadKind {
  brochure
  image
  logo
}

model Upload {
  id        String     @id @default(cuid())
  tenantId  String
  kind      UploadKind
  filename  String
  mime      String
  size      Int
  url       String
  projectId String?
  createdAt DateTime   @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentTrainings AgentTraining[]
}

model AgentTraining {
  id            String   @id @default(cuid())
  tenantId      String
  projectId     String?
  uploadId      String?
  status        String?
  extractedJson Json?
  createdAt     DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  upload  Upload?  @relation(fields: [uploadId], references: [id], onDelete: SetNull)
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String
  email     String?
  phone     String?
  name      String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel])
  @@index([email])
  @@index([phone])
}

model InventoryItem {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  status    String
  dataJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model ProjectDraft {
  id        String   @id @default(cuid())
  tenantId  String
  ownerUid  String?
  projectId String?
  status    String
  title     String
  prompt    String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model AdsBlueprint {
  id        String   @id @default(cuid())
  tenantId  String
  siteId    String?
  dataJson  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model AdsCampaign {
  id        String   @id @default(cuid())
  tenantId  String
  status    String
  dataJson  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deployments AdsDeployment[]
  reports AdsReport[]
  signals AdsLearningSignal[]

  @@index([tenantId, createdAt])
}

model AdsDeployment {
  id         String   @id @default(cuid())
  campaignId String
  status     String
  payload    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign AdsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

model AdsReport {
  id         String   @id @default(cuid())
  campaignId String
  dateId     String
  dataJson   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign AdsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, dateId])
}

model AdsLearningSignal {
  id         String   @id @default(cuid())
  tenantId   String
  campaignId String
  dataJson   Json
  recordedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign AdsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordedAt])
}

model AdsRefinerRun {
  id        String   @id @default(cuid())
  tenantId  String
  siteId    String
  result    Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Wallet {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  type      String
  amount    Decimal
  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model ProjectAction {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String?
  type      String
  text      String?
  payload   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model Order {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String?
  productId String?
  status    String   @default("pending_payment")
  amount    Decimal?
  currency  String?  @default("AED")
  customerEmail String?
  customerPhone String?
  metaJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  payments Payment[]
  entitlements Entitlement[]
  deployment Deployment?
  edits EditRequest[]
  jobs Job[]
  leads Lead[]
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String?
  slug          String   @unique
  title         String
  description   String
  currency      String   @default("AED")
  price         Int
  fulfillmentSlaHours Int @default(24)
  fulfillmentType String
  includesJson  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  orders       Order[]
  deployments  Deployment[]
  entitlements Entitlement[]
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  provider    String
  providerRef String
  status      String
  amount      Decimal?
  currency    String?  @default("AED")
  rawWebhook  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
}

model Entitlement {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String?
  productId String?
  key       String
  valueJson Json?
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, key])
}

model Deployment {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  orderId     String   @unique
  status      String   @default("created")
  previewUrl  String?
  liveUrl     String?
  templateRef String?
  brandKitJson Json?
  intakeJson  Json?
  siteDocJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  edits EditRequest[]
  jobs Job[]
  leads Lead[]
}

model EditRequest {
  id            String   @id @default(cuid())
  tenantId      String
  orderId       String
  deploymentId  String
  status        String   @default("drafting")
  rawText       String?
  compiledTasks Json?
  inputsJson    Json?
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model MarketingSiteConfig {
  id        String   @id @default(cuid())
  tenantId  String?
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
}

model MarketingProduct {
  id          String   @id @default(cuid())
  tenantId    String?
  slug        String   @unique
  title       String
  tagline     String
  description String
  category    String
  badge       String?
  priceLabel  String
  priceNote   String?
  highlights  Json
  deliverables Json
  timeline    Json
  outcomes    Json
  heroImage   String
  demoUrl     String?
  sortOrder   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, sortOrder])
}

model MarketingBlogPost {
  id          String   @id @default(cuid())
  tenantId    String?
  slug        String   @unique
  title       String
  description String
  heroImage   String
  publishedAt DateTime
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, publishedAt])
}

model MarketingLogo {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  imageUrl  String
  row       String
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, row, sortOrder])
  @@unique([row, name])
}

model Job {
  id           String   @id @default(cuid())
  tenantId     String
  ownerUid     String?
  orderId      String?
  deploymentId String?
  type         String
  status       String   @default("queued")
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  payload      Json?
  result       Json?
  error        String?
  lockedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ChatAgent {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String
  name         String
  companyName  String?
  style        String?
  systemPrompt String?
  profile      Json?
  listings     Json?
  tools        Json?
  contact      Json?
  constraints  Json?
  fileUrls     String[] @default([])
  state        String   @default("draft")
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]
  versions AgentVersion[]

  @@unique([userId, name])
}

model AgentMessage {
  id        String   @id @default(cuid())
  agentId   String
  role      String
  content   Json
  createdAt DateTime @default(now())

  agent ChatAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model AgentVersion {
  id           String   @id @default(cuid())
  agentId      String
  version      Int
  systemPrompt String?
  profile      Json?
  listings     Json?
  constraints  Json?
  createdAt    DateTime @default(now())

  agent ChatAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model LoginToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstagramConversation {
  id        String   @id @default(cuid())
  senderId  String
  messages  Json?
  paused    Boolean  @default(false)
  pausedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId])
  @@index([updatedAt])
}

model PaypalPlan {
  id        String   @id @default(cuid())
  planId    String   @unique
  name      String
  createdAt DateTime @default(now())
}
